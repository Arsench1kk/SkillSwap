DATABASE_URL=postgres://skillswap:skillswap@localhost:5433/skillswap
SKILLSWAP_DATA_ORIGIN=rehearsal
# Optional team response time shown on confirmation screens. Leave blank to omit.
OPS_REPLY_HOURS=
# Better Auth. Use a unique random secret of at least 32 characters per environment.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional local development only. Ignored outside development or localhost.
AUTH_DEV_SKIP_EMAIL_VERIFICATION=false
# Set false only for a demo environment without a configured email provider.
AUTH_REQUIRE_EMAIL_VERIFICATION=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Resend transactional email; verify the sender address/domain in Resend first.
RESEND_API_KEY=
AUTH_EMAIL_FROM=SkillSwap <hello@example.com>
